{
  "expo": {
    "name": "Connect Morador",
    "slug": "connect-morador",
    "scheme": "connectmorador",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.connectcondominios.morador"
    },
    "android": {
      "package": "br.com.connectcondominios.morador",
      "adaptiveIcon": {
        "backgroundColor": "#078b4c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Connect usa as suas fotos para você escolher a foto do perfil.",
          "cameraPermission": "O Connect usa a câmera para você tirar a foto do perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Connect usa o Face ID para você entrar sem digitar a senha."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/intro-symbol.png",
          "imageWidth": 58,
          "resizeMode": "contain",
          "backgroundColor": "#0d2e27"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#078b4c",
          "defaultChannel": "chamados"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://app.connect.lab"
    }
  }
}
