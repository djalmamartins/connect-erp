{
  "expo": {
    "name": "Meu Dia Connect",
    "slug": "connect-meu-dia",
    "scheme": "connectmeudia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.connectcondominios.meudia"
    },
    "android": {
      "package": "br.com.connectcondominios.meudia",
      "adaptiveIcon": {
        "backgroundColor": "#0d2e27",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/intro-symbol.png",
          "imageWidth": 58,
          "resizeMode": "contain",
          "backgroundColor": "#0d2e27"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#c5a131",
          "defaultChannel": "meu-dia",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Meu Dia usa o Face ID para abrir a sua agenda sem digitar a senha."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Meu Dia usa as suas fotos para anexar à vistoria.",
          "cameraPermission": "O Meu Dia usa a câmera para tirar as fotos da vistoria.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Meu Dia usa a localização só no check-in da vistoria, para confirmar que você está no condomínio."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://erp.connect.lab"
    }
  }
}
