APP_ENV=local
APP_DEBUG=false
APP_URL=https://www.connect.lab
CONNECT_HTTP_PORT=8088
# Banco único (C5, ADR 0012): serviço legacy-db. O app usa LEGACY_DB_DATABASE.
LEGACY_DB_DATABASE=connect_legacy
LEGACY_DB_USERNAME=connect_legacy
LEGACY_DB_PASSWORD=replace-with-a-random-legacy-password
LEGACY_DB_ROOT_PASSWORD=replace-with-a-different-random-legacy-root-password
# Suíte de testes: banco separado no mesmo servidor, obrigatoriamente terminado em _test.
MOVESOS_TEST_DB=movesos_test

# Proxies confiáveis para ler X-Forwarded-For (IPs ou CIDR, vírgula). Vazio = só REMOTE_ADDR (ADR 0023).
CONNECT_TRUSTED_PROXIES=

# Fila de avisos do ERP no lab (ADR 0055): caixa de teste do modo sandbox (ex.: mailpit). Vazio = só log.
ERP_MAIL_SANDBOX_TO=
# 1 liga o envio SMTP da mail_queue no scheduler (usa MOVESOS_SMTP_* ou, na falta, o SMTP de settings). Deixe 0 no lab.
LAB_MAIL_QUEUE_SEND=0

# SMTP (ADR 0060): vale sobre a tabela settings (ADR 0055 usa este SMTP). Preencha só no .env local ou no cofre, nunca no Git.
MOVESOS_SMTP_HOST=
MOVESOS_SMTP_PORT=587
MOVESOS_SMTP_USER=
MOVESOS_SMTP_PASS=
MOVESOS_SMTP_SECURE=tls
MOVESOS_SMTP_AUTH=true
MOVESOS_SMTP_FROM_ADDRESS=
MOVESOS_SMTP_FROM_NAME=Connect
# Antivírus no upload do Disco Virtual (ADR 0098). off (padrão) = não verifica; enforce = recusa infectado e recusa
# quando o antivírus não responde. Endereço do clamd: unix:///caminho/clamd.sock ou host:porta (sem credencial).
ERP_AV_MODE=
ERP_AV_ENDPOINT=
# Dados de exemplo do lab (ADR 0162, tools/lab-dados-exemplo.php): só com ERP_DEMO_DATA=true e ambiente lab/dev.
# ERP_DEMO_DB libera um banco pelo nome exato quando ele não tem lab/dev/local/sandbox no nome (ex.: connect_legacy).
ERP_DEMO_DATA=
ERP_DEMO_DB=

# Cofre das credenciais bancárias (ADR 0156): 32 bytes em base64. Gere com
# php tools/bank-credentials.php gerar-chave e guarde uma cópia no cofre de senhas.
CONNECT_BANK_VAULT_KEY=

# Connect Talk dentro do ERP (ADR 0324), no host talk.<domínio>. TALK_KEY: cofre das credenciais dos canais de
# WhatsApp, 32 bytes em base64 (php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'); guarde uma cópia no cofre.
# TALK_ENV=lab simula o QR Code e os envios (sem WhatsApp de verdade). TALK_URL: endereço público do Talk, usado nos
# links das conversas. TALK_STORAGE: pasta dos arquivos das conversas (padrão storage/talk, fora da pasta pública).
TALK_KEY=
TALK_ENV=
TALK_URL=
TALK_STORAGE=
TALK_JACK_MODE=auto
# Evolution API (WhatsApp por QR Code). Sem credencial real no Git.
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=
# Lista opcional de IPs para a API /api/v1/talk do Talk separado (ADR 0308), separados por vírgula.
TALK_ALLOWED_IPS=

# Backup na hospedagem (ADR 0325, tools/hosting/backup.sh). Remote "crypt" do rclone por cima do OneDrive
# da Connect, ex.: connect-backup: (configurado com `rclone config` no SSH; a senha da cifragem fica no
# rclone.conf do servidor e numa cópia guardada pelo Djalma, nunca no Git). Vazio = backup só local.
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_LOCAL=3
# Caminho do rclone quando não está no PATH do cron (ex.: /home/uXXXX/bin/rclone).
RCLONE_BIN=
