APP_ENV=local
APP_DEBUG=false
APP_URL=https://www.connect.lab
CONNECT_HTTP_PORT=8088
# Banco único (C5, ADR 0012): serviço legacy-db. O app usa LEGACY_DB_DATABASE.
LEGACY_DB_DATABASE=connect_legacy
LEGACY_DB_USERNAME=connect_legacy
LEGACY_DB_PASSWORD=replace-with-a-random-legacy-password
LEGACY_DB_ROOT_PASSWORD=replace-with-a-different-random-legacy-root-password
# Suíte de testes: banco separado no mesmo servidor, obrigatoriamente terminado em _test.
MOVESOS_TEST_DB=movesos_test

# Proxies confiáveis para ler X-Forwarded-For (IPs ou CIDR, vírgula). Vazio = só REMOTE_ADDR (ADR 0023).
CONNECT_TRUSTED_PROXIES=

# Fila de avisos do ERP no lab (ADR 0055): caixa de teste do modo sandbox (ex.: mailpit). Vazio = só log.
ERP_MAIL_SANDBOX_TO=
# 1 liga o envio SMTP da mail_queue no scheduler (usa MOVESOS_SMTP_* ou, na falta, o SMTP de settings). Deixe 0 no lab.
LAB_MAIL_QUEUE_SEND=0

# SMTP (ADR 0060): vale sobre a tabela settings (ADR 0055 usa este SMTP). Preencha só no .env local ou no cofre, nunca no Git.
MOVESOS_SMTP_HOST=
MOVESOS_SMTP_PORT=587
MOVESOS_SMTP_USER=
MOVESOS_SMTP_PASS=
MOVESOS_SMTP_SECURE=tls
MOVESOS_SMTP_AUTH=true
MOVESOS_SMTP_FROM_ADDRESS=
MOVESOS_SMTP_FROM_NAME=Connect
