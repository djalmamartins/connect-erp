DirectoryIndex index.php
Options -Indexes

RewriteEngine On

# Desempenho (ADR 0611): texto comprimido e arquivos estáticos guardados no navegador.
# A LiteSpeed da hospedagem lê estas mesmas regras. As páginas e a API continuam sem cache (o PHP manda no-store).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json font/ttf font/otf
</IfModule>
# Arquivo com ?v= (a data do arquivo, que muda a cada versão) pode ficar 1 ano no navegador; sem ?v=, 1 dia.
RewriteCond %{QUERY_STRING} (?:^|&)v=
RewriteRule \.(?:css|js|mjs|woff2?|ttf|otf|svg|png|jpe?g|gif|webp|avif|ico)$ - [E=CONNECT_VERSIONED:1]
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|mjs|woff2?|ttf|otf|svg|png|jpe?g|gif|webp|avif|ico)$">
        Header set Cache-Control "public, max-age=86400"
        Header set Cache-Control "public, max-age=31536000, immutable" env=CONNECT_VERSIONED
    </FilesMatch>
</IfModule>

# O app do morador (ADR 0303) manda "Authorization: Bearer". O Apache não repassa esse cabeçalho
# ao PHP sozinho; esta regra o copia para a variável que o PHP lê.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Arquivos de configuração, código interno e dados operacionais nunca são públicos.
<FilesMatch "^(\.env(?:\..*)?|composer\.(json|lock)|phpunit\.xml|README(?:\..*)?)$">
    Require all denied
</FilesMatch>

RewriteRule ^(?:source|service|tests|vendor)(?:/|$) - [F,L,NC]
RewriteRule ^storage/(?:backups|cache|cert|database|logs|media|output|private|sessions|talk|temp|tmp|uploads)(?:/|$) - [F,L,NC]
# Propostas comerciais (nome, e-mail e telefone do interessado) só pela rota do Studio com login (ADR 0388).
RewriteRule ^storage/files/proposals(?:/|$) - [F,L,NC]
# Nada enviado vira página ou script: em storage/ só ficam imagens e documentos (ADR 0388).
# Exceção: o logo SVG que o Studio grava em Configurações, só com o nome que ele gera e com sandbox (ADR 0395).
RewriteCond %{REQUEST_URI} !/storage/images/\d{4}/\d{2}/logo-svg-\d{14}-[0-9a-f]{6}\.svg$
RewriteRule ^storage/.*\.(?:php\d*|phtml|phar|pht|s?html?|xht(?:ml)?|svgz?|m?js)$ - [F,L,NC]
<IfModule mod_headers.c>
    <FilesMatch "^logo-svg-\d{14}-[0-9a-f]{6}\.svg$">
        Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
# Anexos de chamados só pela rota /api/v1/ticket-attachments/{id}, que confere quem pode ver (ADR 0339).
RewriteRule ^storage/(?:files|images)/(?:.*/)?(?:public-)?ticket- - [F,L,NC]

# Defesa extra para quando a pasta pública do subdomínio é a própria pasta do projeto (ADR 0338):
# pastas e arquivos ocultos (.git, .local com os backups do banco, .github, .claude), menos o .well-known do SSL;
# pastas de ferramentas, documentação, migrations e apps; e o código dos temas (só os assets são públicos).
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (?:^|/)\. - [F,L]
RewriteRule ^(?:apps|database|docker|docs|tools)(?:/|$) - [F,L,NC]
RewriteRule ^container/(?!(?:.*/)?assets/).*\.(?:php|sql|md|json|ya?ml|sh|lock|txt)$ - [F,L,NC]
<FilesMatch "\.(?:sql|gz|sh|ya?ml|lock|py|log|bak)$|^(?:CLAUDE\.md|compose\.yaml)$">
    Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
