# Modelo do .env da hospedagem (Hostinger Cloud, ADR 0357). Copie para .env no servidor, fora do Git:
#   cp .env.production.example .env && chmod 600 .env
# Preencha tudo marcado com <...>. Nenhum segredo daqui pode vir do laboratório: gere chaves e senhas novas.
# Depois rode: php service/commands/deploy-check.php (ADR 0354) e php tools/hosting/smoke-http.php --domain=<domínio>.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.connectcondominios.com.br
# http:// vai para https:// (ADR 0364). false só se um proxy na frente não informar o HTTPS e o site entrar em laço.
CONNECT_FORCE_HTTPS=true

# Banco criado no hPanel (MariaDB).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=<banco>
DB_USER=<usuário>
DB_PASS=<senha nova>

# Proxies confiáveis para X-Forwarded-For (vazio = só o IP da conexão; ADR 0023).
CONNECT_TRUSTED_PROXIES=

# 2FA (ADR 0023/0028). Chave: 32 bytes em base64, diferente de todas as outras:
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# ENFORCE_FROM: data (AAAA-MM-DD) a partir da qual a equipe só entra com 2FA.
CONNECT_2FA_KEY=<32 bytes em base64>
CONNECT_2FA_ENFORCE_FROM=<AAAA-MM-DD>

# Cofre das credenciais bancárias (ADR 0156): php tools/bank-credentials.php gerar-chave. Guarde uma cópia no cofre.
CONNECT_BANK_VAULT_KEY=<32 bytes em base64>
# Base pública do webhook dos bancos (vazio = APP_URL).
BANK_WEBHOOK_BASE_URL=https://erp.connectcondominios.com.br
# IPs ou faixas CIDR de onde o banco chama o webhook, separados por vírgula (ADR 0360). Vazio aceita qualquer origem.
BANK_WEBHOOK_ALLOWED_IPS=

# E-mail (ADR 0055/0060). production = os avisos e boletos saem de verdade para os moradores.
ERP_MAIL_DELIVERY=production
ERP_MAIL_SANDBOX_TO=
MOVESOS_SMTP_HOST=<smtp da hospedagem>
MOVESOS_SMTP_PORT=587
MOVESOS_SMTP_USER=<usuário>
MOVESOS_SMTP_PASS=<senha>
MOVESOS_SMTP_SECURE=tls
MOVESOS_SMTP_AUTH=true
MOVESOS_SMTP_FROM_ADDRESS=<avisos@connectcondominios.com.br>
MOVESOS_SMTP_FROM_NAME=Connect

# Dados de exemplo sempre desligados em produção (ADR 0162).
ERP_DEMO_DATA=false
ERP_DEMO_DB=
# Antivírus de upload (ADR 0098): a hospedagem não tem ClamAV; fica desligado.
ERP_AV_MODE=off
ERP_AV_ENDPOINT=

# Central de Ajuda: endereço do sistema e horário de atendimento mostrados ao visitante.
CONNECT_ERP_URL=https://erp.connectcondominios.com.br
CONNECT_SUPPORT_HOURS=De segunda a sexta, das 8h às 18h

# Connect Talk: NÃO usado na hospedagem (ADR 0359). O Talk roda no projeto separado, num Raspberry Pi no escritório,
# e fala com o ERP pela API. Estas linhas ficam comentadas só para o caso de o Talk voltar para dentro do ERP.
# TALK_KEY=<32 bytes em base64>
# TALK_ENV=production
# TALK_URL=https://talk.connectcondominios.com.br
# TALK_STORAGE=
# TALK_JACK_MODE=auto
# EVOLUTION_URL=<https://whatsapp.connectcondominios.com.br>
# EVOLUTION_API_KEY=<chave mostrada pelo instalar.sh do Raspberry Pi>
# EVOLUTION_WEBHOOK_URL=
# TALK_ALLOWED_IPS=

# Backup cifrado no OneDrive (ADR 0325/0334).
BACKUP_RCLONE_REMOTE=<connect-backup:>
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_LOCAL=3
BACKUP_RESTORE_DB=<banco_restore>
RCLONE_BIN=

# Vigia (ADR 0333/0336/0352): e-mail que recebe os alertas e espaço do plano em GB.
ALERT_EMAIL=<alertas@connectcondominios.com.br>
HOSTING_DISK_LIMIT_GB=100
